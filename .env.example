# ───────────────────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env и подставьте свои значения.
# В GitHub те же имена заводятся как Secrets (Settings → Secrets → Actions).
# НИКОГДА не коммитьте .env — он в .gitignore.
# ───────────────────────────────────────────────────────────────────────────

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather, вид: 1234567890:AA...
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
# ID канала. Либо @username_канала, либо числовой -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=@your_channel_username
# Ваш личный user_id (число). Только он может нажимать кнопки апрува.
TELEGRAM_OWNER_ID=000000000

# --- LLM --------------------------------------------------------------------
# anthropic (по умолчанию) | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=put-your-anthropic-key-here
LLM_MODEL=claude-sonnet-5
# Нужен только если LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Картинки (фолбэк на стоки; основной путь — свои карточки) --------------
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Режимы -----------------------------------------------------------------
# 1 = полный прогон без единого обращения в Telegram и к LLM по сети
DRY_RUN=1
LOG_LEVEL=INFO
