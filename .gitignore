# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# state/*.json IS tracked on purpose: the repository is the pipeline's database
# (scripts/commit_state.sh commits it from Actions). Temp files of atomic writes:
state/.*.tmp

# Generated artefacts
out/
assets/generated/
assets/cache/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
